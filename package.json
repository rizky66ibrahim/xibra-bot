{
  "name": "xibra-bot",
  "version": "0.2.0",
  "description": "Xibra Bot: Telegram bot for Xibra Platform. Pairing, news wizard, and planned task and finance commands through Xibra API.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/news/rss.test.ts src/wizard/engine.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "grammy": "^1.36.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
